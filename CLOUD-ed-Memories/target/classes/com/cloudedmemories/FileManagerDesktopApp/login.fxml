<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cloudedmemories.FileManagerDesktopApp.Utility.LoginController"
            prefWidth="400" prefHeight="300" style="-fx-background-color: #ffffff;">
    <children>
        <Label text="Username:" layoutX="50" layoutY="80" />
        <TextField fx:id="usernameField" layoutX="150" layoutY="75" prefWidth="200"/>

        <Label text="Password:" layoutX="50" layoutY="140" />
        <PasswordField fx:id="passwordField" layoutX="150" layoutY="135" prefWidth="200"/>

        <Button fx:id="loginButton" text="Login" layoutX="150" layoutY="200" prefWidth="100"
                onAction="#handleLogin"/>

        <Label fx:id="messageLabel" layoutX="50" layoutY="250" textFill="red"/>
    </children>
</AnchorPane>
